{
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    }
  },
  "disabledMcpjsonServers": {
    "legacy-local": {
      "command": "npx",
      "args": ["-y", "@example/legacy-local"]
    }
  },
  "enabledPlugins": {
    "local-shell": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
