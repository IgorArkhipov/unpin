{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "shell",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/false",
            "timeout": 5,
            "failurePolicy": "continue-degraded"
          }
        ]
      }
    ]
  }
}
